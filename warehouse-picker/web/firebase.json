{
  "hosting": {
    "public": "dist",
    "ignore": [
      "**/.*",
      "**/*.apk",
      "**/*.ipa"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/version.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/shopify.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors https://admin.shopify.com https://*.myshopify.com"
          }
        ]
      }
    ]
  }
}
